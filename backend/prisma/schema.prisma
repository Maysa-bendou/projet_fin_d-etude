generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model services {
  id                                                                              Int                          @id @default(autoincrement())
  name                                                                            String                       @unique @db.VarChar(100)
  technician_services                                                             technician_services[]
  ticket_assignments_history_ticket_assignments_history_from_service_idToservices ticket_assignments_history[] @relation("ticket_assignments_history_from_service_idToservices")
  ticket_assignments_history_ticket_assignments_history_to_service_idToservices   ticket_assignments_history[] @relation("ticket_assignments_history_to_service_idToservices")
  tickets                                                                         tickets[]
}

model tickets {
  id                               Int                          @id @default(autoincrement())
  title                            String                       @db.VarChar(255)
  description                      String?
  category                         category_enum
  status                           ticket_status_enum?          @default(open)
  priority                         priority_enum?
  impact                           impact_enum?
  urgency                          urgency_enum?
  service_id                       Int?
  created_by                       Int?
  assigned_to                      Int?
  solution                         String?
  is_resolved_confirmed            Boolean?                     @default(false)
  sla_due_date                     DateTime?                    @db.Timestamp(6)
  created_at                       DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?                    @default(now()) @db.Timestamp(6)
  ticket_assignments_history       ticket_assignments_history[]
  ticket_attachments               ticket_attachments[]
  ticket_comments                  ticket_comments[]
  users_tickets_assigned_toTousers users?                       @relation("tickets_assigned_toTousers", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_tickets_created_byTousers  users?                       @relation("tickets_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  services                         services?                    @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                                                                        Int                          @id @default(autoincrement())
  name                                                                      String?                      @db.VarChar(100)
  surname                                                                   String?                      @db.VarChar(100)
  email                                                                     String                       @unique @db.VarChar(255)
  password                                                                  String                       @db.VarChar(255)
  role                                                                      String                       @default("employee") @db.VarChar(50)
  phone                                                                     String?                      @db.VarChar(20)
  department                                                                String?                      @db.VarChar(100)
  job_title                                                                 String?                      @db.VarChar(100)
  office                                                                    String?                      @db.VarChar(50)
  block_number                                                              String?                      @db.VarChar(20)
  is_active                                                                 Boolean?                     @default(true)
  created_at                                                                DateTime?                    @default(now()) @db.Timestamp(6)
  technician_services                                                       technician_services[]
  ticket_assignments_history_ticket_assignments_history_from_user_idTousers ticket_assignments_history[] @relation("ticket_assignments_history_from_user_idTousers")
  ticket_assignments_history_ticket_assignments_history_to_user_idTousers   ticket_assignments_history[] @relation("ticket_assignments_history_to_user_idTousers")
  ticket_attachments                                                        ticket_attachments[]
  ticket_comments                                                           ticket_comments[]
  tickets_tickets_assigned_toTousers                                        tickets[]                    @relation("tickets_assigned_toTousers")
  tickets_tickets_created_byTousers                                         tickets[]                    @relation("tickets_created_byTousers")
}

model technician_services {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  service_id Int?
  services   services? @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ticket_assignments_history {
  id                                                            Int       @id @default(autoincrement())
  ticket_id                                                     Int?
  from_user_id                                                  Int?
  to_user_id                                                    Int?
  from_service_id                                               Int?
  to_service_id                                                 Int?
  action                                                        String?   @db.VarChar(50)
  reason                                                        String?
  created_at                                                    DateTime? @default(now()) @db.Timestamp(6)
  services_ticket_assignments_history_from_service_idToservices services? @relation("ticket_assignments_history_from_service_idToservices", fields: [from_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_ticket_assignments_history_from_user_idTousers          users?    @relation("ticket_assignments_history_from_user_idTousers", fields: [from_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets                                                       tickets?  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services_ticket_assignments_history_to_service_idToservices   services? @relation("ticket_assignments_history_to_service_idToservices", fields: [to_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_ticket_assignments_history_to_user_idTousers            users?    @relation("ticket_assignments_history_to_user_idTousers", fields: [to_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ticket_attachments {
  id          Int       @id @default(autoincrement())
  ticket_id   Int?
  file_name   String?   @db.VarChar(255)
  file_path   String?
  uploaded_by Int?
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  tickets     tickets?  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ticket_comments {
  id         Int       @id @default(autoincrement())
  ticket_id  Int?
  user_id    Int?
  comment    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  tickets    tickets?  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum category_enum {
  hardware
  software
  network
  access
  security
  account
}

enum impact_enum {
  low
  medium
  high
}

enum priority_enum {
  low
  medium
  high
  critical
}

enum ticket_status_enum {
  open
  in_progress
  pending
  pending_supplier
  closed
  resolved
  rejected
}

enum urgency_enum {
  low
  medium
  high
}

enum user_role {
  employee
  technician
  chef_service
  manager
  admin
}
