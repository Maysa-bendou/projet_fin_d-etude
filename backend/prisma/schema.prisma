generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model message {
  id                 Int                  @id(map: "ticket_comments_pkey") @default(autoincrement())
  ticket_id          Int?
  user_id            Int?
  comment            String
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  comment_type       String?              @default("comment") @db.VarChar(50)
  ticket             ticket?              @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_comments_ticket_id_fkey")
  user               user?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_comments_user_id_fkey")
  ticket_attachments ticket_attachments[]
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  ticket_id  Int?
  type       String    @db.VarChar(50)
  message    String
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  ticket     ticket?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
}

model service {
  id                                                     Int              @id @default(autoincrement())
  name                                                   String           @unique @db.VarChar(100)
  ticket                                                 ticket[]
  ticket_history_ticket_history_from_service_idToservice ticket_history[] @relation("ticket_history_from_service_idToservice")
  ticket_history_ticket_history_to_service_idToservice   ticket_history[] @relation("ticket_history_to_service_idToservice")
  user                                                   user[]
}

model sla_config {
  id             Int    @id @default(autoincrement())
  priority       String @unique @db.VarChar(50)
  duration_hours Int
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ticket {
  id                            Int                  @id @default(autoincrement())
  title                         String               @db.VarChar(255)
  description                   String?
  category                      category_enum
  status                        ticket_status_enum?  @default(open)
  priority                      priority_enum?
  impact                        impact_enum?
  urgency                       urgency_enum?
  service_id                    Int?
  created_by                    Int?
  assigned_to                   Int?
  solution                      String?
  is_resolved_confirmed         Boolean?             @default(false)
  created_at                    DateTime?            @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?            @default(now()) @db.Timestamp(6)
  type                          request_type_enum?
  sla_duree                     sla_duree?
  sla_date_debut                DateTime?            @default(now()) @db.Timestamptz(6)
  sla_date_limite               DateTime?            @db.Timestamptz(6)
  sla_statut                    String?              @default("en_cours")
  solution_date_resolved        DateTime?            @db.Timestamptz(6)
  confirmation_requested        Boolean?             @default(false)
  closing_note                  String?
  closed_at                     DateTime?            @db.Timestamp(6)
  assigned_at                   DateTime?            @db.Timestamp(6)
  sla_pause_elapsed_ms          BigInt?
  redirect_note                 String?
  assigned_action               String?              @db.VarChar(50)
  message                       message[]
  notifications                 notifications[]
  user_ticket_assigned_toTouser user?                @relation("ticket_assigned_toTouser", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_ticket_created_byTouser  user?                @relation("ticket_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service                       service?             @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_attachments            ticket_attachments[]
  ticket_history                ticket_history[]
}

model ticket_attachments {
  id          Int       @id @default(autoincrement())
  ticket_id   Int?
  file_name   String?   @db.VarChar(255)
  file_path   String?
  uploaded_by Int?
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  comment_id  Int?
  message     message?  @relation(fields: [comment_id], references: [id], onUpdate: NoAction)
  ticket      ticket?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        user?     @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ticket_history {
  id                                              Int       @id @default(autoincrement())
  ticket_id                                       Int?
  from_user_id                                    Int?
  to_user_id                                      Int?
  from_service_id                                 Int?
  to_service_id                                   Int?
  action                                          String?   @db.VarChar(50)
  reason                                          String?
  created_at                                      DateTime? @default(now()) @db.Timestamp(6)
  assigned_by                                     Int?
  user_ticket_history_assigned_byTouser           user?     @relation("ticket_history_assigned_byTouser", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_assignments_history_assigned_by_fkey")
  service_ticket_history_from_service_idToservice service?  @relation("ticket_history_from_service_idToservice", fields: [from_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_assignments_history_from_service_id_fkey")
  user_ticket_history_from_user_idTouser          user?     @relation("ticket_history_from_user_idTouser", fields: [from_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_assignments_history_from_user_id_fkey")
  ticket                                          ticket?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_assignments_history_ticket_id_fkey")
  service_ticket_history_to_service_idToservice   service?  @relation("ticket_history_to_service_idToservice", fields: [to_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_assignments_history_to_service_id_fkey")
  user_ticket_history_to_user_idTouser            user?     @relation("ticket_history_to_user_idTouser", fields: [to_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_assignments_history_to_user_id_fkey")
}

model user {
  id                                               Int                  @id @default(autoincrement())
  name                                             String?              @db.VarChar(100)
  surname                                          String?              @db.VarChar(100)
  email                                            String               @unique @db.VarChar(255)
  password                                         String               @db.VarChar(255)
  role                                             user_role            @default(employee)
  phone                                            String?              @db.VarChar(20)
  department                                       String?              @db.VarChar(100)
  job_title                                        String?              @db.VarChar(100)
  office                                           String?              @db.VarChar(50)
  block_number                                     String?              @db.VarChar(20)
  is_active                                        Boolean?             @default(true)
  created_at                                       DateTime?            @default(now()) @db.Timestamp(6)
  service_id                                       Int?
  message                                          message[]
  notifications                                    notifications[]
  ticket_ticket_assigned_toTouser                  ticket[]             @relation("ticket_assigned_toTouser")
  ticket_ticket_created_byTouser                   ticket[]             @relation("ticket_created_byTouser")
  ticket_attachments                               ticket_attachments[]
  ticket_history_ticket_history_assigned_byTouser  ticket_history[]     @relation("ticket_history_assigned_byTouser")
  ticket_history_ticket_history_from_user_idTouser ticket_history[]     @relation("ticket_history_from_user_idTouser")
  ticket_history_ticket_history_to_user_idTouser   ticket_history[]     @relation("ticket_history_to_user_idTouser")
  service                                          service?             @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_service_id_fkey")
}

enum category_enum {
  hardware
  software
  network
  access
  security
}

enum impact_enum {
  low
  medium
  high
}

enum priority_enum {
  low
  medium
  high
}

enum request_type_enum {
  service_request
  problem
}

enum sla_duree {
  jours    @map("3_jours")
  semaine  @map("1_semaine")
  semaines @map("2_semaines")
}

enum ticket_status_enum {
  open
  in_progress
  pending
  pending_supplier
  closed
  resolved
  rejected
}

enum urgency_enum {
  low
  medium
  high
}

enum user_role {
  employee
  technician
  director
  manager
  admin
}
